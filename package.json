{
  "name": "whatsapp-cli",
  "version": "0.1.0",
  "description": "Terminal WhatsApp client with persistent login, built for humans and AI agents",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
